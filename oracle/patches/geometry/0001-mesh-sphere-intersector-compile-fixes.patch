   //  the size of new_node_per_elem: 2 in 2D and 4 in 3D
-  this->new_node_per_elem = new Array<UInt>(0, 1 + 4 * (dim - 1));
+  this->new_node_per_elem = std::make_unique<Array<Int>>(0, 1 + 4 * (dim - 1));
 }
 
