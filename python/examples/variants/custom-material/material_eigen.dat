# akantu-rs: input file of the marked variant
# python/examples/variants/custom-material/bi-material.py: the law of
# upstream's bi-material.py dict
# {"fictive": {"type": "local_elastic", "rho": 1.0, "E": 1.0, "nu": 0.3}}
# in a model section that pins the static solver's sparse solver to Eigen.
# Not an upstream file.
model solid_mechanics_model [
  material local_elastic [
    name = fictive
    rho = 1.0
    E = 1.0
    nu = 0.3
  ]
  time_step_solver static [
    sparse_solver_type = eigen
  ]
]
