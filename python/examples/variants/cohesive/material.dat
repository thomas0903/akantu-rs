# akantu-rs: marked variant of upstream's
# examples/python/solid_mechanics_cohesive_model/cohesive/material.dat
# (Akantu, EPFL/LSMS, LGPL-3.0-or-later). A static solver section is added to the existing model section.
# Upstream's `_auto` sparse solver resolves to MUMPS in the oracle build;
# the port's solve is bitwise against Eigen's. Every line marked
# "akantu-rs:" is added; the other lines are upstream's.
model solid_mechanics_model_cohesive [
  cohesive_inserter [
    bounding_box = [[0,10],[-10, 10]]
  ]


  material elastic [
           name = virtual
  	 rho = 1     # density
  	 E   = 1   # young's modulus
  	 nu  = 0.3      # poisson's ratio
  	 finite_deformation = true
  ]
  
  material cohesive_linear [
           name = cohesive
  	 sigma_c = 0.1
  	 G_c = 1e-2
  	 beta = 1.
  	 penalty = 10.
  ]
  time_step_solver static [  # akantu-rs: pin the sparse solver
    sparse_solver_type = eigen  # akantu-rs:
  ]  # akantu-rs:
]
