model solid_mechanics_model_cohesive [
  cohesive_inserter [
    cohesive_surfaces = [insertion]
  ]

  material elastic [
    name = body
    rho = 1e3   # density
    E   = 1e9   # young's modulus
    nu  = 0.2 # poisson's ratio
  ]

  material cohesive_linear_friction [
    name = insertion
    beta = 1
    G_c = 10
    sigma_c = 1e6
    penalty = 1e12
    mu = 0.3
    penalty_for_friction = 1e10
    contact_after_breaking = true
  ]
]
