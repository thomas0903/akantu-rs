material elastic [
  name = body
  rho = 1
  E = 1
  nu = 0
]

contact_detector [
  type = explicit
  master = master
  slave = slave
  projection_tolerance = 1e-10
  max_iterations = 100
  extension_tolerance = 1e-5
]

contact_resolution penalty_linear [
  name = contact
  mu = 0.29999999999999999
  epsilon_n = 1000
  epsilon_t = 2000
  is_master_deformable = false
]
